---
// Plantilla común de todas las páginas: <head> con SEO, cabecera y pie.
// Cada página solo aporta su título, su descripción y su contenido (<slot />).
// Saira con el eje de ancho (wdth): permite los títulos anchos al 125 %.
import '@fontsource-variable/saira/wdth.css';
import '../styles/global.css';
import { site } from '../data/site';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Intro from '../components/Intro.astro';

interface Props {
  title?: string;
  description?: string;
  /** Ruta de la imagen para compartir dentro de public/ (1200×630). */
  image?: string;
  /** Animación de entrada (solo en la portada). */
  intro?: boolean;
}

const { title, description = site.description, image = '/og-image.jpg', intro = false } = Astro.props;
// Siempre empieza por el nombre del negocio; en la portada le sigue el lema.
const fullTitle = `${site.name} | ${title ?? site.tagline}`;

// Sin dominio no hay URL canónica: se publica con noindex.
const indexable = Boolean(Astro.site);
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : null;
// La imagen al compartir necesita una dirección completa: la del dominio o, si
// aún no hay, la provisional.
const baseUrl = Astro.site ?? (site.previewUrl ? new URL(site.previewUrl) : null);
const ogImage = baseUrl ? new URL(image, baseUrl).href : null;
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0a0a0a" />
    {intro && (
      <script is:inline>
        // Decide antes de pintar si se muestra la entrada (ver Intro.astro).
        try {
          if (!matchMedia('(prefers-reduced-motion: reduce)').matches && !sessionStorage.getItem('intro-vista')) {
            sessionStorage.setItem('intro-vista', '1');
            document.documentElement.classList.add('con-intro');
          }
        } catch (e) {}
      </script>
    )}
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {!indexable && <meta name="robots" content="noindex, nofollow" />}
    {canonical && <link rel="canonical" href={canonical} />}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Vista previa al compartir (WhatsApp, Instagram, Facebook...) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={site.locale.replace('-', '_')} />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    {intro && <Intro />}
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:rounded focus:bg-light focus:text-paper focus:px-4 focus:py-2"
    >
      Saltar al contenido
    </a>
    <Header />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
  </body>
</html>
