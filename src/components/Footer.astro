---
import { site } from '../data/site';
import Marca from './Marca.astro';
import IconoRed from './IconoRed.astro';
const year = new Date().getFullYear();
---

<footer class="border-t border-line py-10 text-sm text-muted">
  <div class="mx-auto flex max-w-6xl flex-col items-center gap-6 px-4 md:flex-row md:justify-between">
    <Marca pieza="icono" class="h-8 w-8 text-steel" />
    <ul class="flex gap-5" aria-label="Redes sociales">
      {site.redes.map((red) => (
        <li>
          <a href={red.url} target="_blank" rel="noopener" aria-label={red.nombre} class="block transition-colors hover:text-light">
            <IconoRed red={red.id} class="h-5 w-5" />
          </a>
        </li>
      ))}
    </ul>
    <p class="flex flex-wrap justify-center gap-x-4 gap-y-1 text-xs">
      <span>© {year} {site.name}</span>
      <a href="/informacion-legal/" class="hover:text-light">Información legal</a>
      <span>{site.credit.prefix} <a href={site.credit.url} target="_blank" rel="noopener" class="underline underline-offset-2 hover:text-light">{site.credit.name}</a></span>
    </p>
  </div>
</footer>
