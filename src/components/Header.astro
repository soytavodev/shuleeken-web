---
// Cabecera fija con menú móvil. El menú usa <details>/<summary>: se abre y se
// cierra sin JavaScript y es accesible por teclado. Un script mínimo lo cierra
// al presionar un enlace.
import Marca from './Marca.astro';

const nav = [
  { label: 'Redes', href: '/#redes' },
  { label: 'Sobre mí', href: '/#sobre-mi' },
  { label: 'Contacto', href: '/#contacto' },
];
---

<header class="fixed inset-x-0 top-0 z-40 border-b border-line/70 bg-paper/85 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4">
    <a href="/" class="flex items-center gap-3 text-light transition-[filter] duration-300 hover:resplandor focus-visible:resplandor" aria-label="Shuleeken, ir al inicio">
      <Marca pieza="icono" class="h-7 w-7" />
      <Marca pieza="nombre" class="hidden h-3.5 w-[8.5rem] sm:block" />
    </a>

    <nav aria-label="Principal" class="hidden md:block">
      <ul class="flex gap-8 text-sm tracking-[0.2em] uppercase">
        {nav.map((item) => (
          <li><a href={item.href} class="text-muted transition-colors hover:text-light">{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <details class="relative md:hidden" data-menu>
      <summary class="cursor-pointer list-none rounded p-2 text-light" aria-label="Abrir menú">
        <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M3 7h18M3 12h18M3 17h18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
        </svg>
      </summary>
      <nav aria-label="Principal (móvil)" class="absolute right-0 mt-2 w-48 rounded border border-line bg-soft p-2">
        <ul>
          {nav.map((item) => (
            <li><a href={item.href} class="block rounded px-3 py-2 text-sm tracking-[0.2em] uppercase hover:bg-line">{item.label}</a></li>
          ))}
        </ul>
      </nav>
    </details>
  </div>
</header>

<script>
  const menu = document.querySelector<HTMLDetailsElement>('[data-menu]');
  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => (menu.open = false)));
</script>
