---
import Base from '../layouts/Base.astro';
---

<Base title="Página no encontrada">
  <section class="mx-auto max-w-3xl px-4 pt-32 pb-20 text-center">
    <h1 class="titulo text-3xl">Esta página no existe</h1>
    <p class="mt-4 text-muted">Game over. Puede que el enlace esté mal escrito o que la página se haya movido.</p>
    <a href="/" class="mt-8 inline-block rounded bg-light px-6 py-3 font-medium text-paper hover:bg-ink">
      Volver a intentarlo
    </a>
  </section>
</Base>
